	},
}

local REFRESH_SECONDS = 45
local MAX_ROWS = 100
local nextRefreshAt = os.time() + REFRESH_SECONDS

-- Weekly reward section:
-- Fill this with winners manually each week.
local WEEKLY_STREAK_WINNER_USERIDS = {
	-- 123456789,
	-- 987654321,
}
local WEEKLY_STREAK_CHAIR_NAME = "Rainbow"

local rankMaps = {
	cash = {},
	wins = {},
	streak = {},
}

local nameCache = {}
local thumbCache = {}

local function rankColor(rank)
	if rank == 1 then return Color3.fromRGB(255, 210, 75) end
	if rank == 2 then return Color3.fromRGB(210, 210, 220) end
	if rank == 3 then return Color3.fromRGB(205, 140, 80) end
	return Color3.fromRGB(235, 235, 245)
end

local function formatAbbrev(n)
	n = tonumber(n) or 0
	local abs = math.abs(n)
	if abs >= 1e12 then return string.format("%.1fT", n / 1e12):gsub("%.0T", "T") end
	if abs >= 1e9 then return string.format("%.1fB", n / 1e9):gsub("%.0B", "B") end
	if abs >= 1e6 then return string.format("%.1fM", n / 1e6):gsub("%.0M", "M") end
	if abs >= 1e3 then return string.format("%.1fK", n / 1e3):gsub("%.0K", "K") end
	return tostring(math.floor(n))
end

local function formatWithCommas(n)
	n = tostring(math.floor(tonumber(n) or 0))
	local left, num, right = n:match("^([^%d]*%d)(%d*)(.-)$")
	return left .. (num:reverse():gsub("(%d%d%d)", "%1,"):reverse()) .. right
end

local function prettyValue(statName, value)
	if statName == "Cash" then
		return "$" .. formatAbbrev(value)
	elseif statName == "Wins" then
		return "🏆 " .. formatWithCommas(value)
	elseif statName == "Winstreak" then
		return "🔥 " .. formatWithCommas(value)
	end
	return tostring(value)
end

local function safeNameFromUserId(userId)
	if nameCache[userId] then return nameCache[userId] end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local final = ok and name or ("User_" .. tostring(userId))
	nameCache[userId] = final
	return final
end

local function safeThumb(userId)
	if thumbCache[userId] then return thumbCache[userId] end
	local ok, image = pcall(function()
		return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
	end)
	local final = ok and image or ""
	thumbCache[userId] = final
	return final
end

local function getLeaderboardPart(modelName)
	local model = workspace:FindFirstChild(modelName)
	if not model then return nil end
	local part = model:FindFirstChild("LeaderboardPart")
	if part and part:IsA("BasePart") then return part end
	return nil
end

local function getBoardInstances(cfg)
	local boards = {}

	local starterBoard = StarterGui:FindFirstChild(cfg.guiName, true)
	if starterBoard and starterBoard:IsA("SurfaceGui") then
		table.insert(boards, starterBoard)
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		local pg = plr:FindFirstChild("PlayerGui")
		if pg then
			local board = pg:FindFirstChild(cfg.guiName, true)
			if board and board:IsA("SurfaceGui") then
				table.insert(boards, board)
			end
		end
	end

	return boards
end

local function getGuiRefs(surfaceGui)
	local root = surfaceGui:FindFirstChild("Root")
	if not root then return nil end

	local list = root:FindFirstChild("ListScroll", true) or root:FindFirstChild("RowsScroll", true)
	if not list or not list:IsA("ScrollingFrame") then return nil end

	local template = list:FindFirstChild("RowTemplate")
	if not template or not template:IsA("Frame") then return nil end

	local title = root:FindFirstChild("Title", true)

	return {
		root = root,
		list = list,
		template = template,
		title = title,
	}
end

local function clearRows(list, template)
	for _, c in ipairs(list:GetChildren()) do
		if c:IsA("Frame") and c ~= template then
			c:Destroy()
		end
	end
end

local function fetchRows(cfg)
	local out = {}
	local rankMap = {}

	local ok, pages = pcall(function()
		return cfg.store:GetSortedAsync(false, MAX_ROWS)
	end)
	if not ok or not pages then
		warn("[LB] GetSortedAsync failed:", cfg.guiName)
		return out, rankMap
	end

	for rank, item in ipairs(pages:GetCurrentPage()) do
		local userId = tonumber(item.key)
		local value = tonumber(item.value) or 0
		if userId then
			rankMap[userId] = rank
			table.insert(out, {
				rank = rank,
				userId = userId,
				value = value,
				name = safeNameFromUserId(userId),
				thumb = safeThumb(userId),
			})
		end
	end

	return out, rankMap
end

local function renderIntoBoard(boardGui, cfg, rows)
	local refs = getGuiRefs(boardGui)
	if not refs then return end

	if refs.title and refs.title:IsA("TextLabel") then
		refs.title.Text = cfg.title
	end

	clearRows(refs.list, refs.template)
	refs.template.Visible = false

	for _, entry in ipairs(rows) do
		local row = refs.template:Clone()
		row.Name = "Row_" .. tostring(entry.rank)
		row.Visible = true
		row.LayoutOrder = entry.rank
		row.Parent = refs.list

		local rankLbl = row:FindFirstChild("Rank")
		local nameLbl = row:FindFirstChild("Name")
		local valueLbl = row:FindFirstChild("Value")
		local avatar = row:FindFirstChild("Avatar")

		if rankLbl and rankLbl:IsA("TextLabel") then
			rankLbl.Text = "#" .. tostring(entry.rank)
			rankLbl.TextColor3 = rankColor(entry.rank)
		end
		if nameLbl and nameLbl:IsA("TextLabel") then
			nameLbl.Text = entry.name
			nameLbl.TextColor3 = rankColor(entry.rank)
		end
		if valueLbl and valueLbl:IsA("TextLabel") then
			valueLbl.Text = prettyValue(cfg.statName, entry.value)
			valueLbl.TextColor3 = rankColor(entry.rank)
		end
		if avatar and avatar:IsA("ImageLabel") then
			avatar.Image = entry.thumb
		end
	end

	refs.list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	refs.list.CanvasSize = UDim2.new(0, 0, 0, 0)
end

local function pushStatToBoard(player, statName)
	local stats = player:FindFirstChild("leaderstats")
	local stat = stats and stats:FindFirstChild(statName)
	if not (stat and stat:IsA("IntValue")) then return end

	for _, cfg in ipairs(BOARD_CONFIG) do
		if cfg.statName == statName then
			pcall(function()
				cfg.store:SetAsync(tostring(player.UserId), stat.Value)
			end)
		end
	end
end

local function renderBoard(cfg)
	local rows, map = fetchRows(cfg)

	if cfg.statName == "Cash" then
		rankMaps.cash = map
	elseif cfg.statName == "Wins" then
		rankMaps.wins = map
	elseif cfg.statName == "Winstreak" then
		rankMaps.streak = map
	end

	local boards = getBoardInstances(cfg)
	local adorneePart = getLeaderboardPart(cfg.modelName)

	for _, board in ipairs(boards) do
		if adorneePart then
			board.Adornee = adorneePart
		end
		renderIntoBoard(board, cfg, rows)
	end
end

local function refreshAllBoards()
	for _, cfg in ipairs(BOARD_CONFIG) do
		renderBoard(cfg)
	end
	nextRefreshAt = os.time() + REFRESH_SECONDS
end

_G.GetLeaderboardRanksForPlayer = function(player)
	if not player then return nil end
	return {
		cash = rankMaps.cash[player.UserId],
		wins = rankMaps.wins[player.UserId],
		streak = rankMaps.streak[player.UserId],
	}
end

