-- Countdown label on CountdownPart -> BillboardGui -> TimerLbl
local function timerLabel()
	local part = workspace:FindFirstChild("LeaderboardResetPart") or workspace:FindFirstChild("CountdownPart")
	if not part or not part:IsA("BasePart") then return nil end

	local bb = part:FindFirstChildWhichIsA("BillboardGui")
	if not bb then return nil end

	local lbl = bb:FindFirstChild("TimerLbl", true)
	if lbl and lbl:IsA("TextLabel") then return lbl end

	lbl = bb:FindFirstChildWhichIsA("TextLabel", true)
	if lbl and lbl:IsA("TextLabel") then return lbl end
	return nil
end

task.spawn(function()
	while true do
		local lbl = timerLabel()
		if lbl then
			local left = math.max(0, nextRefreshAt - os.time())
			lbl.Text = "Refresh in: " .. tostring(left) .. "s"
		end
		task.wait(1)
	end
end)

Players.PlayerAdded:Connect(function(player)
	player:WaitForChild("leaderstats", 20)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then return end

	for _, cfg in ipairs(BOARD_CONFIG) do
		local stat = stats:FindFirstChild(cfg.statName)
		if stat and stat:IsA("IntValue") then
			pushStatToBoard(player, cfg.statName)
			stat.Changed:Connect(function()
				pushStatToBoard(player, cfg.statName)
			end)
		end
	end

	task.delay(2, function()
		if player.Parent then
			refreshAllBoards()
		end
	end)
end)

-- Winstreak rank prompt part:
-- Workspace.WinstreakRankPart should contain/accept a ProximityPrompt
local rankPart = workspace:FindFirstChild("WinstreakRankPart")
if rankPart and rankPart:IsA("BasePart") then
	local prompt = rankPart:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Check Rank"
		prompt.ObjectText = "Winstreak Rank"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = rankPart
	end

	prompt.Triggered:Connect(function(player)
		local rank = rankMaps.streak[player.UserId]
		local msg = rank and ("Your Winstreak Rank: #" .. tostring(rank)) or "Your Winstreak Rank: >100"
		NotifyPlayer:FireClient(player, {
			title = "Winstreak Rank",
			message = msg,
			kind = rank and (rank <= 3 and "success" or "info") or "warn",
			duration = 3,
		})
	end)
end

task.spawn(function()
	while true do
		refreshAllBoards()
		task.wait(REFRESH_SECONDS)
	end
end)

game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do
		for _, cfg in ipairs(BOARD_CONFIG) do
			pushStatToBoard(p, cfg.statName)
		end
	end
end)

print("[GlobalLeaderboards] Ready")
