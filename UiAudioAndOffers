-- Gamepass cycle + change anim
local gpIndex = 1

local gpScale = cycleGpBtn:FindFirstChildOfClass("UIScale")
if not gpScale then
	gpScale = Instance.new("UIScale")
	gpScale.Scale = 1
	gpScale.Parent = cycleGpBtn
end

local function renderCurrentGp()
	local gp = GAMEPASS_OFFERS[gpIndex] or GAMEPASS_OFFERS[1]
	if not gp then return end
	setImage(gpOfferIcon, gp.icon)
	setLabelText(gpNameLbl, gp.name, "Offer")
	setLabelText(gpPriceLbl, gp.priceText, "0") -- FIXED
end

local function animateGpChange()
	local out1 = TweenService:Create(gpOfferIcon, TweenInfo.new(0.1), { ImageTransparency = 0.35 })
	local out2 = TweenService:Create(gpNameLbl, TweenInfo.new(0.1), { TextTransparency = 0.35 })
	local out3 = TweenService:Create(gpPriceLbl, TweenInfo.new(0.1), { TextTransparency = 0.35 })
	out1:Play(); out2:Play(); out3:Play()
	task.wait(0.1)

	renderCurrentGp()

	local in1 = TweenService:Create(gpOfferIcon, TweenInfo.new(0.1), { ImageTransparency = 0 })
	local in2 = TweenService:Create(gpNameLbl, TweenInfo.new(0.1), { TextTransparency = 0 })
	local in3 = TweenService:Create(gpPriceLbl, TweenInfo.new(0.1), { TextTransparency = 0 })
	in1:Play(); in2:Play(); in3:Play()

	local p1 = TweenService:Create(gpScale, TweenInfo.new(0.08), { Scale = 1.05 })
	local p2 = TweenService:Create(gpScale, TweenInfo.new(0.08), { Scale = 1.0 })
	p1:Play()
	p1.Completed:Wait()
	p2:Play()
end

renderCurrentGp()

task.spawn(function()
	while offersUi.Parent do
		task.wait(3.5)
		gpIndex += 1
		if gpIndex > #GAMEPASS_OFFERS then
			gpIndex = 1
		end
		animateGpChange()
	end
end)

cycleGpBtn.Activated:Connect(function()
	local gp = GAMEPASS_OFFERS[gpIndex] or GAMEPASS_OFFERS[1]
	if gp and gp.id and gp.id > 0 then
		MarketplaceService:PromptGamePassPurchase(player, gp.id)
	end
end)

