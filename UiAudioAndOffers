-- Sounds
-- =========================
local hoverSound = Instance.new("Sound")
hoverSound.Name = "UiHover"
hoverSound.SoundId = HOVER_SOUND_ID
hoverSound.Volume = 0.55
hoverSound.Parent = SoundService

local clickSound = Instance.new("Sound")
clickSound.Name = "UiClick"
clickSound.SoundId = CLICK_SOUND_ID
clickSound.Volume = 0.6
clickSound.Parent = SoundService

pcall(function()
	ContentProvider:PreloadAsync({ hoverSound, clickSound })
end)

local function playSound(soundObj)
	if not soundObj then return end
	soundObj.TimePosition = 0
	SoundService:PlayLocalSound(soundObj)
end

local function bindButtonSounds(btn)
	if not btn or (not btn:IsA("TextButton") and not btn:IsA("ImageButton")) then
		return
	end
	if btn:GetAttribute("UiSfxBound") then return end
	btn:SetAttribute("UiSfxBound", true)

	btn.MouseEnter:Connect(function()
		playSound(hoverSound)
	end)

	btn.Activated:Connect(function()
		playSound(clickSound)
	end)
end

-- Bind open UI buttons anywhere in GameGui
for _, d in ipairs(gameGui:GetDescendants()) do
	if d:IsA("TextButton") or d:IsA("ImageButton") then
		local n = string.lower(d.Name)
		if n:find("open") and (n:find("inv") or n:find("reward") or n:find("shop")) then
			bindButtonSounds(d)
		end
	end
end

gameGui.DescendantAdded:Connect(function(d)
