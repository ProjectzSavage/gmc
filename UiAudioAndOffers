local function setLabelText(lbl, value, fallback)
	if lbl and lbl:IsA("TextLabel") then
		lbl.Text = tostring(value or fallback or "")
	end
end

local function setImage(img, value)
	if img and img:IsA("ImageLabel") then
		img.Image = tostring(value or "")
	end
end

-- Starter static button
