local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local events = ReplicatedStorage:WaitForChild("Events")
local NotifyPlayer = events:WaitForChild("NotifyPlayer")

local triggerPart = workspace:WaitForChild("LeaderboardNotifyPart")
local inside = {}

local STORES = {
	cash = DataStoreService:GetOrderedDataStore("GMC_LB_CASH_V1"),
	wins = DataStoreService:GetOrderedDataStore("GMC_LB_WINS_V1"),
	streak = DataStoreService:GetOrderedDataStore("GMC_LB_STREAK_V1"),
}

local MAX_ROWS = 100
local NOTIFY_COOLDOWN = 10
local lastNotifyAt = {}

local function kindFromBest(best)
	if best == 1 then return "success" end
	if best == 2 then return "info" end
	if best == 3 then return "warn" end
	return "info"
end

local function fmt(rank)
	if rank then return "#" .. tostring(rank) end
	return ">100"
end

local function bestRank(r)
	if not r then return nil end
	local vals = {}
	if r.cash then table.insert(vals, r.cash) end
	if r.wins then table.insert(vals, r.wins) end
	if r.streak then table.insert(vals, r.streak) end
	if #vals == 0 then return nil end
	table.sort(vals)
	return vals[1]
end

local function getRankInStore(store, userId)
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, MAX_ROWS)
	end)
	if not ok or not pages then return nil end

	local rows = pages:GetCurrentPage()
	for rank, entry in ipairs(rows) do
		if tonumber(entry.key) == userId then
			return rank
		end
	end
	return nil
end

local function getRanks(player)
	local userId = player.UserId
	return {
		cash = getRankInStore(STORES.cash, userId),
		wins = getRankInStore(STORES.wins, userId),
		streak = getRankInStore(STORES.streak, userId),
	}
end

local function showRankNotify(player)
	local now = os.clock()
	local prev = lastNotifyAt[player.UserId] or 0
	if now - prev < NOTIFY_COOLDOWN then return end
	lastNotifyAt[player.UserId] = now

	local ranks = getRanks(player)
	local b = bestRank(ranks)

	NotifyPlayer:FireClient(player, {
		title = "Your Leaderboard Rank",
		message = "Cash " .. fmt(ranks.cash) .. " | Wins " .. fmt(ranks.wins) .. " | Streak " .. fmt(ranks.streak),
		kind = kindFromBest(b),
		duration = 4,
	})
end

triggerPart.Touched:Connect(function(hit)
	local character = hit and hit.Parent
	if not character then return end

	local player = Players:GetPlayerFromCharacter(character)
	if not player then return end
	if inside[player.UserId] then return end

	inside[player.UserId] = true
	showRankNotify(player)
end)

RunService.Heartbeat:Connect(function()
	for userId in pairs(inside) do
		local p = Players:GetPlayerByUserId(userId)
		if not p then
			inside[userId] = nil
		else
			local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then
				inside[userId] = nil
			else
				local maxDist = (triggerPart.Size.Magnitude * 0.65) + 8
				if (hrp.Position - triggerPart.Position).Magnitude > maxDist then
					inside[userId] = nil
				end
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	inside[player.UserId] = nil
	lastNotifyAt[player.UserId] = nil
end)

print("[LeaderboardTouchNotify] Ready (GlobalLeaderboards)")
