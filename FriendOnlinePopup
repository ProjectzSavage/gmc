local function setAvatar(userId)
	local ok, thumb = pcall(function()
		return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
	end)
	avatarImg.Image = ok and thumb or "rbxassetid://0"
end

local function hidePopup()
	if countdownConn then
		countdownConn:Disconnect()
		countdownConn = nil
	end
	if popup and popup.Visible then
		local tw = TweenService:Create(
			popup,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Position = UDim2.fromScale(0.5, -0.24) }
		)
		tw:Play()
		tw.Completed:Wait()
	end
	popup.Visible = false
end

local function showPopup(friendName, friendUserId)
	titleLbl.Text = string.format("%s is online!", friendName)
	rewardLbl.Text = REWARD_TEXT
	setAvatar(friendUserId)

	popup.Position = UDim2.fromScale(0.5, -0.24)
	popup.Visible = true
	TweenService:Create(
		popup,
		TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Position = UDim2.fromScale(0.5, 0.02) }
	):Play()

	local started = tick()
	countdownFill.Size = UDim2.fromScale(1, 1)

	if countdownConn then countdownConn:Disconnect() end
	countdownConn = RunService.Heartbeat:Connect(function()
		local elapsed = tick() - started
		local left = math.max(0, POPUP_SECONDS - elapsed)
		local ratio = left / POPUP_SECONDS

		countdownFill.Size = UDim2.fromScale(ratio, 1)
		countdownText.Text = string.format("Closes in %ds", math.ceil(left))

		if left <= 0 then
			hidePopup()
		end
	end)
end

local function fetchFriendsOnline()
	local ok, list = pcall(function()
		return player:GetFriendsOnline(200)
	end)
	if not ok or type(list) ~= "table" then return {} end
	return list
end

local function bootstrapPresence()
	for _, entry in ipairs(fetchFriendsOnline()) do
		if entry.IsOnline and entry.VisitorId then
			knownOnline[entry.VisitorId] = true
		end
	end
end

local function pollForNewOnlineFriend()
	local list = fetchFriendsOnline()
	local nowOnline = {}

	for _, entry in ipairs(list) do
		if entry.IsOnline and entry.VisitorId then
			nowOnline[entry.VisitorId] = true

			local wasOnline = knownOnline[entry.VisitorId] == true
			local alreadyShown = shownOnce[entry.VisitorId] == true

			if not wasOnline and not alreadyShown and not popup.Visible then
				shownOnce[entry.VisitorId] = true
				showPopup(entry.UserName or "Friend", entry.VisitorId)
				break
			end
		end
	end

	knownOnline = nowOnline
end

createGui()

inviteBtn.MouseButton1Click:Connect(function()
	pcall(function()
		SocialService:PromptGameInvite(player)
	end)
end)

closeBtn.MouseButton1Click:Connect(hidePopup)

bootstrapPresence()

task.spawn(function()
	while true do
		pollForNewOnlineFriend()
		task.wait(15)
	end
end)

print("[FriendOnlinePopup] Ready")
