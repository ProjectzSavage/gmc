local step = 1
local maxStep = 4

local function lookAtPoint(pointName)
	local folder = workspace:FindFirstChild("TutorialPoints")
	local p = folder and folder:FindFirstChild(pointName)
	if not p or not p:IsA("BasePart") then return end

	local cam = workspace.CurrentCamera
	if not cam then return end

	-- Camera goes behind the marker based on marker orientation.
	local backDistance = 12
	local height = 6
	local lookForward = 18

	local camPos = p.Position - (p.CFrame.LookVector * backDistance) + Vector3.new(0, height, 0)
	local lookPos = p.Position + (p.CFrame.LookVector * lookForward)

	cam.CameraType = Enum.CameraType.Scriptable
	TweenService:Create(
		cam,
		TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = CFrame.lookAt(camPos, lookPos) }
	):Play()
end

local function releaseCamera()
	local cam = workspace.CurrentCamera
	if not cam then return end
	cam.CameraType = Enum.CameraType.Custom
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then cam.CameraSubject = hum end
end

local function render()
	backBtn.Visible = step > 1 and step < maxStep
	nextBtn.Visible = step < maxStep
	rewardRow.Visible = (step == 1)
	stayBotBtn.Visible = (step == maxStep)
	go1v1Btn.Visible = (step == maxStep)

	if step == 1 then
		title.Text = "Welcome!"
		body.Text = "Instant reward to get started right now."
	elseif step == 2 then
		title.Text = "1v1 Tables"
		body.Text = "These tables are for real players. Queue here when others are online."
		lookAtPoint("LookAt1v1")
	elseif step == 3 then
		title.Text = "Bot Mode"
		body.Text = "Practice solo anytime. Click Next and we will move you there."
		lookAtPoint("LookAtBot")
	elseif step == 4 then
		title.Text = "Choose Your Path"
		body.Text = "Stay in bot mode to practice, or go to 1v1 if players are active."
		releaseCamera()

		local ok, canJoin = pcall(function()
			return RequestCanJoin1v1:InvokeServer()
		end)
		canJoin = ok and canJoin == true

		go1v1Btn.Active = canJoin
		go1v1Btn.AutoButtonColor = canJoin
		go1v1Btn.BackgroundColor3 = canJoin and Color3.fromRGB(38, 180, 95) or Color3.fromRGB(95, 95, 95)
		go1v1Btn.Text = canJoin and "Go To 1v1" or "Go To 1v1 (No players)"
	end
end
local ok, state = pcall(function()
	return RequestTutorialState:InvokeServer()
end)
if not ok or type(state) ~= "table" then
	return
end

if state.completed then
	completed=true
	return
end

gui.Enabled = true
render()

if not state.rewardClaimed then
	ClaimTutorialReward:FireServer()
end
nextBtn.Activated:Connect(function()
	if step == 3 then
		TutorialTeleport:FireServer("TeleportBot")
	end
	step = math.min(step + 1, maxStep)
	render()
end)

backBtn.Activated:Connect(function()
	step = math.max(step - 1, 1)
	render()
end)

stayBotBtn.Activated:Connect(function()
	SetTutorialComplete:FireServer()
	gui.Enabled = false
	releaseCamera()
end)

go1v1Btn.Activated:Connect(function()
	if not go1v1Btn.Active then return end
	TutorialTeleport:FireServer("Teleport1v1")
	SetTutorialComplete:FireServer()
	
	gui.Enabled = false
	releaseCamera()
end)

