local RS = game:GetService("ReplicatedStorage")

local shopChairs = RS:WaitForChild("Chairs"):WaitForChild("ShopChairs")

local FALLBACK_PRICES = {
	Cardboard=200, Metal=400, Rusty=600, Sand=800, Joker=900, Grass=1000, Rock=1400,
	Brick=1800, Candy=2400, Ice=3000, Snow=4000, Shiny=5000, Mirror=6500, Water=7000,
	Magma=8000, Zap=12000, Radioactive=16000, Lava=20000, Demon=24000, Angel=30000,
	Pure=50000, Void=50000,
}

local EXCLUDE = {
	Joker = true,
}

local function getPrices()
	if type(_G.CHAIR_PRICES) == "table" then
		return _G.CHAIR_PRICES
	end
	return FALLBACK_PRICES
end

local function formatPrice(price)
	if price >= 1000 then
		local k = price / 1000
		if math.floor(k) == k then
			return tostring(math.floor(k)) .. "k"
		end
		return string.format("%.1fk", k)
	end
	return tostring(price)
end

local function updateChair(chairModel)
	if not chairModel:IsA("Model") then return end
	if EXCLUDE[chairModel.Name] then return end

	local prices = getPrices()
	local price = prices[chairModel.Name]
	if not price then
		warn("[ShopChairLabelSync] Missing price for", chairModel.Name)
		return
	end

	local updated = 0
	for _, d in ipairs(chairModel:GetDescendants()) do
		if d:IsA("TextLabel") and d.Name == "OwnedLbl" then
			d.Text = "$" .. formatPrice(price)
			updated += 1
		end
	end

	if updated == 0 then
		warn("[ShopChairLabelSync] No OwnedLbl found in", chairModel.Name)
	end
end

local function refreshAll()
	for _, chair in ipairs(shopChairs:GetChildren()) do
		updateChair(chair)
	end
end

refreshAll()

shopChairs.ChildAdded:Connect(function(chair)
	task.defer(function()
		updateChair(chair)
	end)
end)

-- periodic healing in case models reinsert or scripts overwrite labels
task.spawn(function()
	while true do
		task.wait(10)
		refreshAll()
	end
end)

print("[ShopChairLabelSync] Ready")
