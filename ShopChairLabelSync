local RS = game:GetService("ReplicatedStorage")

local shopChairs = RS:WaitForChild("Chairs"):WaitForChild("ShopChairs")

local CHAIR_PRICES = {
	Cardboard = 200, Metal = 400, Rusty = 600, Sand = 800, Joker = 900000,
	Grass = 1000, Rock = 1400, Brick = 1800, Candy = 2400, Ice = 3000,
	Snow = 4000, Shiny = 5000, Mirror = 6500, Water = 7000, Magma = 8000,
	Zap = 12000, Radioactive = 16000, Lava = 20000, Demon = 24000, Angel = 30000,
	Pure = 50000, Void = 50000,
}

local EXCLUDE = {
	Joker = true,
}

local function updateChairLabel(chairModel)
	if not chairModel or not chairModel:IsA("Model") then return end
	if EXCLUDE[chairModel.Name] then return end

	local price = CHAIR_PRICES[chairModel.Name]
	if not price then return end

	local ownedLbl = chairModel:FindFirstChild("OwnedLbl", true)
	if not ownedLbl or not ownedLbl:IsA("TextLabel") then
		return
	end

	ownedLbl.Text = "$" .. tostring(price)
end

for _, chair in ipairs(shopChairs:GetChildren()) do
	updateChairLabel(chair)
end

shopChairs.ChildAdded:Connect(function(chair)
	task.defer(function()
		updateChairLabel(chair)
	end)
end)

print("[ShopChairLabelSync] Ready")
