local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local events = ReplicatedStorage:WaitForChild("Events")
local CountryData = require(ReplicatedStorage:WaitForChild("CountryData"))

local function event(name)
	return events:WaitForChild(name)
end

local function ensureRemote(name)
	local r = events:FindFirstChild(name)
	if r then return r end
	r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = events
	return r
end

local E = {
	ShowLetterPick = event("ShowLetterPick"),
	LetterChosen = event("LetterChosen"),
	ShowCountryPick = event("ShowCountryPick"),
	CountryChosen = event("CountryChosen"),
	ShowLetterGuess = event("ShowLetterGuess"),
	SubmitLetterGuess = event("SubmitLetterGuess"),
	LetterGuessResult = event("LetterGuessResult"),
	ShowCountryGuess = event("ShowCountryGuess"),
	SubmitCountryGuess = event("SubmitCountryGuess"),
	CountryGuessResult = event("CountryGuessResult"),
	ShowWait = event("ShowWait"),
	ShowBillboard = event("ShowBillboard"),
	TimerTick = event("TimerTick"),
	GameOver = event("GameOver"),
	NotifyPlayer = event("NotifyPlayer"), -- add this
}

local BotTableCountdown = ensureRemote("BotTableCountdown")
local BotTableStatus = ensureRemote("BotTableStatus")

local CFG = {
	COUNTDOWN_START = 3,
	TURN_TIME = 45,
	ASK_TO_RESPONSE_DELAY = 1.25,
	BOT_THINK = 1.9,
	RESPONSE_DISPLAY_TIME = 1.6,
	SWITCH_DELAY = 0.8,
}
local BOT_REWARDS = {
	Cash = 150,
	Wins = 1,
	Winstreak = 1,
}

local function awardBotWin(player)
	if not player then return end
	local stats = player:FindFirstChild("leaderstats")
	if not stats then return end

	local cash = stats:FindFirstChild("Cash")
	local wins = stats:FindFirstChild("Wins")
	local streak = stats:FindFirstChild("Winstreak")

	if cash and cash:IsA("IntValue") then
		local mult = _G.RewardsCashMultiplier and _G.RewardsCashMultiplier(player) or 1
		cash.Value += BOT_REWARDS.Cash * mult
	end

	if wins and wins:IsA("IntValue") then
		wins.Value += BOT_REWARDS.Wins
	end

	if streak and streak:IsA("IntValue") then
		local mult = _G.RewardsStreakMultiplier and _G.RewardsStreakMultiplier(player) or 1
		streak.Value += BOT_REWARDS.Winstreak * mult
	end
	print("[BotReward]", player.Name, "cashMult", _G.RewardsCashMultiplier and _G.RewardsCashMultiplier(player), "streakMult", _G.RewardsStreakMultiplier and _G.RewardsStreakMultiplier(player))
end

local function resetStreak(player)
	if not player then return end
	local stats = player:FindFirstChild("leaderstats")
	local streak = stats and stats:FindFirstChild("Winstreak")
	if streak and streak:IsA("IntValue") then
		streak.Value = 0
	end
end
local sessions = {}
local playerToTable = {}

local runPlayerTurn
local runBotTurn
local botCountryGuess

local function setBotLocked(player, locked)
	if _G.BotSeatManager and _G.BotSeatManager.setPlayerLocked then
		_G.BotSeatManager.setPlayerLocked(player, locked == true)
	end
end

local function countryListForLetter(letter)
	local list = CountryData.ByLetter[string.upper(letter or "")]
	return (type(list) == "table") and list or {}
end

local function randomCountryForLetter(letter)
	local list = countryListForLetter(letter)
	if #list == 0 then return nil end
	local entry = list[math.random(1, #list)]
	return entry and entry.name or nil
end

local function randomLetterWithCountries()
	local letters = {}
	for i = 65, 90 do
		local l = string.char(i)
		if #countryListForLetter(l) > 0 then
			table.insert(letters, l)
		end
	end
	if #letters == 0 then return "A" end
	return letters[math.random(1, #letters)]
end

local function byteOfLetter(letter)
	return string.byte(string.upper(letter or "A")) - 64
end

local function letterOfByte(value)
	return string.char(64 + math.clamp(value, 1, 26))
end

local function getDisplayLabel(tableId)
	local model = _G.BotSeatManager and _G.BotSeatManager.getTableModel and _G.BotSeatManager.getTableModel(tableId)
	if not model then return nil end
	local displayPart = model:FindFirstChild("BotDisplay")
	if not displayPart then return nil end
	local billboard = displayPart:FindFirstChildWhichIsA("BillboardGui")
	if not billboard then return nil end
	local lbl = billboard:FindFirstChild("Lbl") or billboard:FindFirstChild("Text") or billboard:FindFirstChildWhichIsA("TextLabel")
	if lbl and lbl:IsA("TextLabel") then return lbl end
	return nil
end
local function notifyThinking(session)
	if not session or not session.player or not E.NotifyPlayer then return end
	local hint = (session.playerSecret and session.playerSecret.country) or "?"
	E.NotifyPlayer:FireClient(session.player, {
		title = "Bot is thinking...",
		message = "Your country: " .. tostring(hint),
		kind = "info",
		duration = CFG.SWITCH_DELAY + 1.25,
	})
end
local function botSpeak(tableId, text)
	local lbl = getDisplayLabel(tableId)
	if lbl then lbl.Text = tostring(text or "") end
end

local function clearBotDisplay(tableId)
	botSpeak(tableId, "")
end

local function clearTableStatus(tableId)
	BotTableStatus:FireAllClients(tableId, "")
end

local function waitBotAnswered(session, text)
	E.ShowWait:FireClient(session.player, "Bot answered: " .. tostring(text or ""), nil, nil, nil)
end

local function clearVisuals(tableId)
	BotTableCountdown:FireAllClients(tableId, 0)
	clearTableStatus(tableId)
	clearBotDisplay(tableId)
end

local function clearSession(tableId)
	local session = sessions[tableId]
	if not session then
		clearVisuals(tableId)
		return
	end

	sessions[tableId] = nil
	playerToTable[session.player.UserId] = nil
	setBotLocked(session.player, false)
	clearVisuals(tableId)

	if _G.BotSeatManager and _G.BotSeatManager.setPromptEnabled then
		_G.BotSeatManager.setPromptEnabled(tableId, true)
	end
end

local function endSession(tableId, winnerName, reason)
	local session = sessions[tableId]
	if not session or not session.active then return end

	session.active = false
	session.token += 1
	clearTableStatus(tableId)

	local playerWon = (winnerName == session.player.Name)
	if playerWon then
		awardBotWin(session.player)
	else
		resetStreak(session.player)
	end
	botSpeak(tableId, playerWon and "You win!" or "Bot wins!")

	E.GameOver:FireClient(session.player, {
		winner = winnerName,
		reason = reason or "",
		rewardCash = playerWon and 200 or 0,
	})

	task.delay(1.2, function()
		if _G.BotSeatManager and _G.BotSeatManager.standPlayer then
			_G.BotSeatManager.standPlayer(session.player, true)
		end
		clearSession(tableId)
	end)
end

local function showPlayerAsk(session, text)
	clearBotDisplay(session.tableId)
	E.ShowBillboard:FireClient(session.player, session.player.Name, text, "white")
end

local function showPlayerReply(session, text, color)
	E.ShowBillboard:FireClient(session.player, session.player.Name, text, color or "white")
end

local function showBotAsk(session, text)
	botSpeak(session.tableId, text)
end

local function showBotReply(session, text)
	local msg = tostring(text or "")
	botSpeak(session.tableId, msg)
	waitBotAnswered(session, msg)
end

local function queueBotTurn(session)
	if not session.active then return end
	session.turn = "bot"
	notifyThinking(session)

	task.delay(CFG.SWITCH_DELAY, function()
		if session.active and session.turn == "bot" then
			runBotTurn(session)
		end
	end)
end

local function switchToPlayerAfterBotResponse(session)
	task.delay(CFG.RESPONSE_DISPLAY_TIME, function()
		if session.active then
			runPlayerTurn(session)
		end
	end)
end

runPlayerTurn = function(session)
	if not session.active then return end

	session.turn = "player"
	session.token += 1
	local turnToken = session.token

	clearBotDisplay(session.tableId)
	clearTableStatus(session.tableId)

	if session.playerMode == "letter" then
		E.ShowLetterGuess:FireClient(session.player, {
			opponentName = "BOT",
			eliminatedMin = session.playerSecret.elimMin,
			eliminatedMax = session.playerSecret.elimMax,
			timeLeft = CFG.TURN_TIME,
		})
	else
		local wrongList = {}
		for name, used in pairs(session.playerSecret.wrongCountries) do
			if used then table.insert(wrongList, name) end
		end
		table.sort(wrongList)

		E.ShowCountryGuess:FireClient(session.player, {
			opponentName = "BOT",
			letter = session.botSecret.letter,
			countries = countryListForLetter(session.botSecret.letter),
			wrongList = wrongList,
			timeLeft = CFG.TURN_TIME,
		})
	end

	task.spawn(function()
		for t = CFG.TURN_TIME, 1, -1 do
			if not session.active or session.token ~= turnToken or session.turn ~= "player" then return end
			E.TimerTick:FireClient(session.player, t)
			task.wait(1)
		end

		if not session.active or session.token ~= turnToken or session.turn ~= "player" then return end

		if session.playerMode == "letter" then
			E.LetterGuessResult:FireClient(session.player, {
				result = "timeout",
				message = "TIMEOUT",
				eliminatedMin = session.playerSecret.elimMin,
				eliminatedMax = session.playerSecret.elimMax,
			})
		else
			E.CountryGuessResult:FireClient(session.player, {
				result = "timeout",
				message = "TIMEOUT",
			})
		end

		queueBotTurn(session)
	end)
end

botCountryGuess = function(session)
	local knowledge = session.botKnowledge
	if not knowledge then return end

	local list = countryListForLetter(knowledge.letter)
	if #list == 0 then
		runPlayerTurn(session)
		return
	end

	local pickName
	for _, c in ipairs(list) do
		if not knowledge.wrongCountries[c.name] then
			pickName = c.name
			break
		end
	end

	if not pickName then
		runPlayerTurn(session)
		return
	end

	showBotAsk(session, "Is your country " .. pickName .. "?")
	local askToken = session.token

	task.delay(CFG.BOT_THINK, function()
		if not session.active or session.turn ~= "bot" or session.token ~= askToken then return end

		if string.lower(pickName) == string.lower(session.playerSecret.country) then
			showPlayerReply(session, "YES", "green")
			task.delay(CFG.RESPONSE_DISPLAY_TIME, function()
				if session.active then
					endSession(session.tableId, "BOT", "bot_country_guessed")
				end
			end)
			return
		end

		knowledge.wrongCountries[pickName] = true
		showPlayerReply(session, "NO", "red")
		switchToPlayerAfterBotResponse(session)
	end)
end

runBotTurn = function(session)
	if not session.active then return end

	session.turn = "bot"
	session.token += 1
	local turnToken = session.token

	local knowledge = session.botKnowledge
	if not knowledge then return end

	if not knowledge.letterKnown then
		local guessByte = math.floor((knowledge.elimMin + knowledge.elimMax) / 2)
		local guessLetter = letterOfByte(guessByte)
		local playerByte = byteOfLetter(session.playerSecret.letter)

		showBotAsk(session, "Is your letter " .. guessLetter .. "?")

		task.delay(CFG.BOT_THINK, function()
			if not session.active or session.turn ~= "bot" or session.token ~= turnToken then return end

			if guessByte == playerByte then
				knowledge.letterKnown = true
				knowledge.letter = guessLetter
				showPlayerReply(session, "YES", "green")
				switchToPlayerAfterBotResponse(session)
				return
			end

			if guessByte < playerByte then
				knowledge.elimMin = math.max(knowledge.elimMin, guessByte)
				showPlayerReply(session, "HIGHER", "yellow")
			else
				knowledge.elimMax = math.min(knowledge.elimMax, guessByte)
				showPlayerReply(session, "LOWER", "yellow")
			end

			switchToPlayerAfterBotResponse(session)
		end)

		return
	end

	botCountryGuess(session)
end

local function startGame(session)
	if not session.active then return end
	session.phase = "turn"
	session.turn = "player"
	session.playerMode = "letter"

	setBotLocked(session.player, true)
	clearTableStatus(session.tableId)
	runPlayerTurn(session)
end

local function beginCountryPick(session)
	session.phase = "country-pick"
	clearTableStatus(session.tableId)
	E.ShowCountryPick:FireClient(session.player, {
		letter = session.playerSecret.letter,
		countries = countryListForLetter(session.playerSecret.letter),
	})
end

local function beginLetterPick(session)
	session.phase = "letter-pick"
	clearTableStatus(session.tableId)
	E.ShowLetterPick:FireClient(session.player)
end

local function createSession(tableId, player)
	if sessions[tableId] then return end

	local botLetter = randomLetterWithCountries()
	local botCountry = randomCountryForLetter(botLetter)

	local session = {
		tableId = tableId,
		player = player,
		active = true,
		phase = "countdown",
		turn = "none",
		token = 0,
		playerMode = "letter",
		playerSecret = {
			letter = nil,
			country = nil,
			elimMin = 0,
			elimMax = 27,
			wrongCountries = {},
		},
		botSecret = {
			letter = botLetter,
			country = botCountry,
		},
		botKnowledge = {
			elimMin = 0,
			elimMax = 27,
			letterKnown = false,
			letter = nil,
			wrongCountries = {},
		},
	}

	sessions[tableId] = session
	playerToTable[player.UserId] = tableId

	if _G.BotSeatManager and _G.BotSeatManager.setPromptEnabled then
		_G.BotSeatManager.setPromptEnabled(tableId, false)
	end

	setBotLocked(player, false)
	clearTableStatus(tableId)
	clearBotDisplay(tableId)

	task.spawn(function()
		for t = CFG.COUNTDOWN_START, 1, -1 do
			if not session.active then return end
			BotTableCountdown:FireAllClients(tableId, t)
			task.wait(1)
		end

		if not session.active then return end
		setBotLocked(player, true)
		BotTableCountdown:FireAllClients(tableId, 0)
		clearTableStatus(tableId)
		beginLetterPick(session)
	end)
end

_G.OnBotSeated = function(tableId, player)
	createSession(tableId, player)
end

_G.OnBotStood = function(player, tableId)
	clearVisuals(tableId)
	setBotLocked(player, false)

	local session = sessions[tableId]
	if not session or session.player ~= player then return end
	session.active = false
	session.token += 1
	clearSession(tableId)
end

do
	local baseGetSessionByPlayer = _G.GetSessionByPlayer
	_G.GetSessionByPlayer = function(player)
		local tableId = player and playerToTable[player.UserId]
		if tableId then
			local s = sessions[tableId]
			if s and s.active then
				local fakeBot = { UserId = -100000 - player.UserId, Name = "BOT" }
				return {
					active = true,
					playerA = player,
					playerB = fakeBot,
					secret = {
						[player.UserId] = { letter = s.playerSecret.letter, country = s.playerSecret.country },
						[fakeBot.UserId] = { letter = s.botSecret.letter, country = s.botSecret.country },
					},
				}
			end
		end
		if baseGetSessionByPlayer then
			return baseGetSessionByPlayer(player)
		end
		return nil
	end
end
_G.GetBotSessionByPlayer = function(player)
	if not player then return nil end
	local tableId = playerToTable[player.UserId]
	if not tableId then return nil end

	local s = sessions[tableId]
	if not s or not s.active then return nil end

	local fakeBot = { UserId = -100000 - player.UserId, Name = "BOT" }
	return {
		active = true,
		playerA = player,
		playerB = fakeBot,
		secret = {
			[player.UserId] = { letter = s.playerSecret.letter, country = s.playerSecret.country },
			[fakeBot.UserId] = { letter = s.botSecret.letter, country = s.botSecret.country },
		},
	}
end
E.LetterChosen.OnServerEvent:Connect(function(player, letter)
	local tableId = playerToTable[player.UserId]
	if not tableId then return end
	local session = sessions[tableId]
	if not session or not session.active or session.phase ~= "letter-pick" then return end
	if session.player ~= player then return end

	local upper = string.upper(tostring(letter or ""))
	if #countryListForLetter(upper) == 0 then return end
	session.playerSecret.letter = upper
	beginCountryPick(session)
end)

E.CountryChosen.OnServerEvent:Connect(function(player, country)
	local tableId = playerToTable[player.UserId]
	if not tableId then return end
	local session = sessions[tableId]
	if not session or not session.active or session.phase ~= "country-pick" then return end
	if session.player ~= player then return end

	local exists = false
	for _, c in ipairs(countryListForLetter(session.playerSecret.letter)) do
		if string.lower(c.name) == string.lower(tostring(country or "")) then
			exists = true
			break
		end
	end
	if not exists then return end

	session.playerSecret.country = tostring(country)
	startGame(session)
end)

E.SubmitLetterGuess.OnServerEvent:Connect(function(player, guessLetter)
	local tableId = playerToTable[player.UserId]
	if not tableId then return end
	local session = sessions[tableId]
	if not session or not session.active then return end
	if session.player ~= player or session.turn ~= "player" or session.playerMode ~= "letter" then return end

	local guess = string.upper(tostring(guessLetter or ""))
	if #guess ~= 1 then return end
	local guessed = byteOfLetter(guess)
	local actual = byteOfLetter(session.botSecret.letter)

	session.token += 1
	local askToken = session.token
	showPlayerAsk(session, "Is your letter " .. guess .. "?")

	task.delay(CFG.ASK_TO_RESPONSE_DELAY, function()
		if not session.active or session.turn ~= "player" or session.token ~= askToken then return end

		if guessed == actual then
			E.LetterGuessResult:FireClient(player, {
				result = "correct",
				message = "YES",
				eliminatedMin = session.playerSecret.elimMin,
				eliminatedMax = session.playerSecret.elimMax,
			})
			showBotReply(session, "YES")
			session.playerMode = "country"
		elseif guessed < actual then
			session.playerSecret.elimMin = math.max(session.playerSecret.elimMin, guessed)
			E.LetterGuessResult:FireClient(player, {
				result = "higher",
				message = "HIGHER",
				eliminatedMin = session.playerSecret.elimMin,
				eliminatedMax = session.playerSecret.elimMax,
			})
			showBotReply(session, "HIGHER")
		else
			session.playerSecret.elimMax = math.min(session.playerSecret.elimMax, guessed)
			E.LetterGuessResult:FireClient(player, {
				result = "lower",
				message = "LOWER",
				eliminatedMin = session.playerSecret.elimMin,
				eliminatedMax = session.playerSecret.elimMax,
			})
			showBotReply(session, "LOWER")
		end

		queueBotTurn(session)
	end)
end)

E.SubmitCountryGuess.OnServerEvent:Connect(function(player, countryGuess)
	local tableId = playerToTable[player.UserId]
	if not tableId then return end
	local session = sessions[tableId]
	if not session or not session.active then return end
	if session.player ~= player or session.turn ~= "player" or session.playerMode ~= "country" then return end

	local guess = tostring(countryGuess or "")
	if guess == "" then return end

	session.token += 1
	local askToken = session.token
	showPlayerAsk(session, "Is your country " .. guess .. "?")

	task.delay(CFG.ASK_TO_RESPONSE_DELAY, function()
		if not session.active or session.turn ~= "player" or session.token ~= askToken then return end

		if string.lower(guess) == string.lower(session.botSecret.country) then
			E.CountryGuessResult:FireClient(player, {
				result = "correct",
				message = "YES",
			})
			showBotReply(session, "YES")
			task.delay(CFG.RESPONSE_DISPLAY_TIME, function()
				if session.active then
					endSession(tableId, player.Name, "player_country_guessed")
				end
			end)
			return
		end

		session.playerSecret.wrongCountries[guess] = true
		local wrongList = {}
		for name, used in pairs(session.playerSecret.wrongCountries) do
			if used then table.insert(wrongList, name) end
		end
		table.sort(wrongList)

		E.CountryGuessResult:FireClient(player, {
			result = "no",
			message = "NO",
			wrongName = guess,
			wrongList = wrongList,
		})
		showBotReply(session, "NO")

		queueBotTurn(session)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	local tableId = playerToTable[player.UserId]
	if not tableId then return end
	local session = sessions[tableId]
	if session then
		session.active = false
		session.token += 1
	end
	clearSession(tableId)
end)

