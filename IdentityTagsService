local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local GROUP_ID = 35973544 -- TODO
local VIP_GAMEPASS_ID = 1839628382 -- TODO

local OWNER_IDS = { 
	3107183806,
	3721585498,
}
local VERIFIED_IDS = {
	3107183806,
	3721585498,-- TODO
}
local HAMMER_IDS = {
	3107183806,
	3721585498,-- TODO
}

local function toSet(t)
	local s = {}
	for _, id in ipairs(t) do s[id] = true end
	return s
end

local OWNER = toSet(OWNER_IDS)
local VERIFIED = toSet(VERIFIED_IDS)
local HAMMER = toSet(HAMMER_IDS)

local function inGroup(p)
	if GROUP_ID <= 0 then return false end
	local ok, result = pcall(function() return p:IsInGroup(GROUP_ID) end)
	return ok and result == true
end

local function hasVip(p)
	if VIP_GAMEPASS_ID <= 0 then return false end
	local ok, result = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(p.UserId, VIP_GAMEPASS_ID)
	end)
	return ok and result == true
end

local function apply(p)
	p:SetAttribute("HasVIP", hasVip(p))
	p:SetAttribute("InGroupTag", inGroup(p))
	p:SetAttribute("HasPremiumTag", p.MembershipType == Enum.MembershipType.Premium)
	p:SetAttribute("IsVerifiedTag", VERIFIED[p.UserId] == true)
	p:SetAttribute("IsHammerTag", HAMMER[p.UserId] == true)
	p:SetAttribute("IsOwnerTag", OWNER[p.UserId] == true)
end

Players.PlayerAdded:Connect(apply)
for _, p in ipairs(Players:GetPlayers()) do apply(p) end

task.spawn(function()
	while true do
		for _, p in ipairs(Players:GetPlayers()) do
			apply(p)
		end
		task.wait(60)
	end
end)

print("[IdentityTagsService] Ready")
