local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local showcaseFolder = workspace:WaitForChild("RobuxChairShowcase")
local rigTemplate = RS:WaitForChild("ShowroomR15Template")

local function clearDummies()
	local old = workspace:FindFirstChild("LocalShowroomDummies")
	if old then
		old:Destroy()
	end
end

local function getPlayerDescription()
	local ok, desc = pcall(function()
		return Players:GetHumanoidDescriptionFromUserIdAsync(player.UserId)
	end)
	if ok and desc then
		return desc
	end
	return Instance.new("HumanoidDescription")
end

local function getSeatOffset(displaySeat)
	local cf = displaySeat:FindFirstChild("DummyOffset")
	if cf and cf:IsA("CFrameValue") then
		return cf.Value
	end

	local att = displaySeat:FindFirstChild("DummyAttachment")
	if att and att:IsA("Attachment") then
		return att.CFrame
	end

	-- Forward-facing default
	return CFrame.new(0, 1.65, 0)
end

local function getSitAnimId()
	local character = player.Character
	if character then
		local animate = character:FindFirstChild("Animate")
		if animate and animate:FindFirstChild("sit") and animate.sit:FindFirstChild("SitAnim") then
			local id = animate.sit.SitAnim.AnimationId
			if typeof(id) == "string" and id ~= "" then
				return id
			end
		end
	end
	return "rbxassetid://507768133"
end

local function removeAnimateScript(model)
	local animate = model:FindFirstChild("Animate")
	if animate and (animate:IsA("Script") or animate:IsA("LocalScript")) then
		animate:Destroy()
	end
end

local function setupRigPhysics(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.Massless = true
		end
	end
end

local function seatDummyOnDisplaySeat(displaySeat, desc, parentFolder)
	if not displaySeat:IsA("Seat") then return end

	local chairModel = displaySeat:FindFirstAncestorOfClass("Model")
	if not chairModel then return end

	local dummy = rigTemplate:Clone()
	dummy.Name = "LocalChairDummy_" .. chairModel.Name
	dummy.Parent = parentFolder

	removeAnimateScript(dummy)

	local humanoid = dummy:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid:ApplyDescriptionAsync(desc)
		end)
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.NameDisplayDistance = 0
		humanoid.AutoRotate = false
		humanoid.HipHeight = 0
	end

	local root = dummy:FindFirstChild("HumanoidRootPart", true)
	if not root or not root:IsA("BasePart") then
		dummy:Destroy()
		return
	end

	setupRigPhysics(dummy)

	-- Place root where seated root should be
	local seatOffset = getSeatOffset(displaySeat)
	root.CFrame = displaySeat.CFrame * seatOffset

	-- Weld to seat so it follows chair movement exactly
	local weld = Instance.new("WeldConstraint")
	weld.Name = "DisplaySeatWeld"
	weld.Part0 = root
	weld.Part1 = displaySeat
	weld.Parent = root

	-- Force seated state
	if humanoid and humanoid.Health > 0 then
		humanoid.Sit = true
		humanoid:ChangeState(Enum.HumanoidStateType.Seated)

		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end

		local anim = Instance.new("Animation")
		anim.AnimationId = getSitAnimId()
		local track = animator:LoadAnimation(anim)
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = true
		track:Play(0.1, 1, 1)
	end
end

local function rebuildDummies()
	clearDummies()

	local folder = Instance.new("Folder")
	folder.Name = "LocalShowroomDummies"
	folder.Parent = workspace

	local desc = getPlayerDescription()

	for _, inst in ipairs(showcaseFolder:GetDescendants()) do
		if inst:IsA("Seat") and inst.Name == "DisplaySeat" then
			seatDummyOnDisplaySeat(inst, desc, folder)
		end
	end
end

rebuildDummies()

showcaseFolder.DescendantAdded:Connect(function(inst)
	if inst:IsA("Seat") and inst.Name == "DisplaySeat" then
		task.wait(0.1)
		rebuildDummies()
	end
end)

showcaseFolder.DescendantRemoving:Connect(function(inst)
	if inst:IsA("Seat") and inst.Name == "DisplaySeat" then
		task.wait()
		rebuildDummies()
	end
end)
